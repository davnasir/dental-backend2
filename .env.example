# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27017/dental_clinic"

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_this_to_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client
CLIENT_URL=http://localhost:5173

# Comma-separated list of frontend origin(s) allowed to exchange data with this
# API. Requests carrying an Origin header that is NOT listed here are rejected
# with 403. Leave empty to use the default allowlist (CLIENT_URL + localhost +
# naholdentalcare.com.bd). Set to a strict value in production, e.g.:
# ALLOWED_ORIGINS=https://www.naholdentalcare.com.bd
ALLOWED_ORIGINS=

# Cookie SameSite policy: "none" (cross-site, requires HTTPS/Secure) or "lax".
# Defaults to "none" in production, "lax" in development.
# COOKIE_SAME_SITE=none

# Seed (first super-admin account created by `npm i mongodb`).
# In production the API auto-seeds an empty database on startup using these
# credentials, so existing data is never touched once the first admin exists.
# On `npm install` an empty database is seeded automatically. If
# SEED_ADMIN_PASSWORD is unset a random one is generated and printed once --
# capture it from the install output.
SEED_ADMIN_EMAIL=superadmin@nahol.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=123456789
# Skip the automatic database setup that runs on `npm install` (useful in
# container builds and CI, where no database is reachable yet).
# SKIP_DB_SETUP=1
# Re-run the seed even when the database already has data.
# SEED_FORCE=1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Nahol Dental Care <noreply@example.com>"

# WhatsApp
WHATSAPP_NUMBER=8801948921229

# SMS gateway (MRAM)
# Normal operation needs none of this: paste the API key into
# Settings -> SMS Gateway in the admin panel and it is stored encrypted in the
# database. The values below are the fallback used when the panel has nothing
# saved (and are what CI or a container image would use instead).
#
# Patients are texted once when they book an appointment and again when staff
# confirm it. Message wording lives in src/config/smsTemplates.js.
#
# Generate the key in the MRAM panel: Developers -> Regenerate Key. MRAM must
# approve the key and your sender ID before messages are accepted.
SMS_ENABLED=0
SMS_PROVIDER=mram
SMS_API_KEY=
SMS_SENDER_ID=
# "text" for English, "unicode" for Bangla. Only used if the panel leaves it unset.
SMS_TYPE=text
SMS_TIMEOUT_MS=10000
# Optional: encrypts the stored API key with a secret of your choosing instead of
# the JWT secret. If you set this, keep it stable -- rotating it means every
# stored key must be entered again.
# SMS_SECRET_KEY=

# --- Other providers ---
# "generic" talks to any HTTP gateway, with the field names mapped by env vars.
# "sslwireless" needs only an API secret. "mock" logs instead of sending.
# SMS_PROVIDER=generic
# SMS_ENDPOINT=https://api.example.com/send
# SMS_API_SECRET=
# SMS_HTTP_METHOD=POST
# SMS_CONTENT_TYPE=form
# SMS_AUTH_STYLE=body
# SMS_NUMBER_FIELD=to
# SMS_MESSAGE_FIELD=message
# SMS_API_KEY_FIELD=api_key
# SMS_API_SECRET_FIELD=api_secret
# SMS_SENDER_ID_FIELD=sender_id
# SMS_AUTH_HEADER=Authorization

# Gateways often return HTTP 200 even for rejected numbers or empty balances, so
# the response body is scanned for these markers before a send is called a
# success. Override only if your provider's wording causes false positives.
# SMS_FAIL_KEYWORDS=fail,error,invalid,unauthorized,forbidden,denied,reject,insufficient,no credit,blacklist

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Prescriptions
# How long a prescription stays valid before it is permanently deleted. Measured
# in MONTHS (default 6), so "6 months" is calendar-accurate rather than a fixed
# number of days. Every record gets its own expireAt (creation time + this
# window), enforced by a MongoDB TTL index, so records expire independently.
# PRESCRIPTION_RETENTION_MONTHS=6
# Optional day-based override, if you ever need an exact number of days:
# PRESCRIPTION_RETENTION_DAYS=30
