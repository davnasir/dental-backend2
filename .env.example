# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27017/dental_clinic"

# Auth
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_this_to_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client
CLIENT_URL=http://localhost:5173

# Comma-separated list of frontend origin(s) allowed to exchange data with this
# API. Requests carrying an Origin header that is NOT listed here are rejected
# with 403. Leave empty to use the default allowlist (CLIENT_URL + localhost +
# naholdentalcare.com.bd). Set to a strict value in production, e.g.:
# ALLOWED_ORIGINS=https://www.naholdentalcare.com.bd
ALLOWED_ORIGINS=

# Cookie SameSite policy: "none" (cross-site, requires HTTPS/Secure) or "lax".
# Defaults to "none" in production, "lax" in development.
# COOKIE_SAME_SITE=none

# Seed (first super-admin account created by `npm i mongodb`).
# In production the API auto-seeds an empty database on startup using these
# credentials, so existing data is never touched once the first admin exists.
SEED_ADMIN_EMAIL=superadmin@nahol.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=123456789

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Nahol Dental Care <noreply@example.com>"

# WhatsApp
WHATSAPP_NUMBER=8801948921229

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
